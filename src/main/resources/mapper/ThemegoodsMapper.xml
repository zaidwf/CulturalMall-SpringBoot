<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.ThemegoodsMapper">

    <insert id="insert" parameterType="com.example.entity.Themegoods" useGeneratedKeys="true">
        insert into themegoods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsId != null">goods_id,</if>
            <if test="themeId != null">theme_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsId != null">#{goodsId},</if>
            <if test="themeId != null">#{themeId},</if>
        </trim>
    </insert>

    <delete id="deleteById">
        delete from themegoods
        where themegoods.goods_id = #{id}
    </delete>
</mapper>
